rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /content/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'bQvKgi7p9XSjnotieGHd7UlwNjD3';
    }

    match /quizResults/{resultId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null
        && request.auth.uid == 'bQvKgi7p9XSjnotieGHd7UlwNjD3';
      allow update: if false;
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if request.auth != null
        && request.auth.uid == 'bQvKgi7p9XSjnotieGHd7UlwNjD3';
      allow update: if false;
    }

    match /activityRecords/{recordId} {
      allow get: if true;
      allow create: if resource == null
        && request.resource.data.keys().hasOnly(['teacherName', 'className', 'sections', 'section', 'activityName', 'activityDate', 'contact', 'contactKey', 'contactType', 'createdAt'])
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 100
        && request.resource.data.className is string
        && request.resource.data.className.size() > 0
        && request.resource.data.className.size() <= 20
        && request.resource.data.sections is list
        && request.resource.data.sections.size() > 0
        && request.resource.data.sections.size() <= 10
        && request.resource.data.sections.hasOnly(['A', 'B', 'C', 'Science', 'Commerce', 'Humanities'])
        && request.resource.data.section is string
        && request.resource.data.section.size() <= 200
        && request.resource.data.activityName is string
        && request.resource.data.activityName.size() > 0
        && request.resource.data.activityName.size() <= 200
        && request.resource.data.activityDate is string
        && request.resource.data.activityDate.size() == 10
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0
        && request.resource.data.contact.size() <= 200
        && request.resource.data.contactKey is string
        && request.resource.data.contactKey == recordId
        && request.resource.data.contactType is string
        && request.resource.data.contactType in ['email', 'phone']
        && request.resource.data.createdAt == request.time;
      allow list, delete: if request.auth != null
        && request.auth.uid == 'bQvKgi7p9XSjnotieGHd7UlwNjD3';
      allow update: if false;
    }

    match /activityDates/{dateId} {
      allow create: if resource == null
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow get: if true;
      allow list, delete: if request.auth != null
        && request.auth.uid == 'bQvKgi7p9XSjnotieGHd7UlwNjD3';
      allow update: if false;
    }

  }
}
